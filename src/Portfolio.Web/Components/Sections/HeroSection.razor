@inject ILanguageContext LanguageContext
@inject ITranslator Localizer

<section class="pf-hero" id="hero" aria-labelledby="hero-title">
    <div class="pf-hero__glow" aria-hidden="true"></div>

    <div class="pf-container pf-hero__inner">
        <div class="pf-hero__content">
            <span class="pf-hero__availability">
                <span class="pf-hero__pulse" aria-hidden="true"></span>
                @Profile.Availability
            </span>

            <h1 class="pf-hero__title" id="hero-title">
                @Profile.Name
                <span class="pf-hero__role">@Profile.Role</span>
            </h1>

            <p class="pf-hero__tagline">@Profile.Tagline</p>
            <p class="pf-hero__summary">@Profile.Summary</p>

            <div class="pf-hero__actions">
                <a class="pf-button pf-button--primary" href="@LanguageContext.BuildHref("projects")">
                    <span>@Localizer["Hero.CtaExplore"]</span>
                    <Icon Name="arrow-right" Size="18" />
                </a>
                <a class="pf-button pf-button--ghost" href="@LanguageContext.BuildHref("contact")">
                    <Icon Name="mail" Size="18" />
                    <span>@Localizer["Hero.CtaContact"]</span>
                </a>
            </div>

            <ul class="pf-hero__focus" aria-label="@Localizer["Hero.FocusAria"]">
                @foreach (var area in Profile.FocusAreas)
                {
                    <li>
                        <Icon Name="check" Size="14" />
                        @area
                    </li>
                }
            </ul>
        </div>

        <aside class="pf-hero__sidebar" aria-label="@Localizer["Hero.ProfileAria"]">
            <div class="pf-card pf-code">
                <div class="pf-code__bar" aria-hidden="true">
                    <span class="pf-code__dot"></span>
                    <span class="pf-code__dot"></span>
                    <span class="pf-code__dot"></span>
                    <span class="pf-code__file">Developer.cs</span>
                </div>
                <pre class="pf-code__body"><code>public sealed class Developer
{
    public string Name => "@Profile.Name";
    public string Role => "@Profile.Role";
    public string Location => "@Profile.Location";
    public string[] Focus => ["Backend", "APIs", "Blazor", "MAUI"];
}</code></pre>
            </div>

            <div class="pf-hero__socials">
                <a class="pf-social" href="@Profile.GitHubUrl" target="_blank" rel="noopener noreferrer" aria-label="@Localizer["Common.GithubAria"]">
                    <Icon Name="github" Size="20" />
                </a>
                <a class="pf-social" href="@Profile.LinkedInUrl" target="_blank" rel="noopener noreferrer" aria-label="@Localizer["Common.LinkedInAria"]">
                    <Icon Name="linkedin" Size="20" />
                </a>
                <a class="pf-social" href="@($"mailto:{Profile.Email}")" aria-label="@Localizer["Common.EmailAria", Profile.Name]">
                    <Icon Name="mail" Size="20" />
                </a>
            </div>
        </aside>
    </div>

    <div class="pf-container pf-hero__stats">
        @foreach (var stat in Stats)
        {
            <StatsCard Stats="stat" />
        }
    </div>

    @if (Technologies.Count > 0)
    {
        <TechnologyMarquee Badges="Technologies" />
    }
</section>

@code {
    [Parameter, EditorRequired]
    public LocalizedProfile Profile { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<StatsCardViewModel> Stats { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<TechnologyBadgeViewModel> Technologies { get; set; } = [];
}
