@inject ILanguageContext LanguageContext
@inject LocalizedProfile Profile

@{
    var language = LanguageContext.Language;
    var root = $"{Profile.PublicBaseUrl.TrimEnd('/')}{Profile.NormalizedBasePath}";
    var neutralPath = LanguageContext.NeutralPath;

    var currentRelative = language == Language.En
        ? (neutralPath.Length == 0 ? "en" : $"en/{neutralPath}")
        : neutralPath;

    var canonical = (root + currentRelative).TrimEnd('/');
    var spanishUrl = neutralPath.Length == 0 ? root.TrimEnd('/') : root + neutralPath;
    var englishUrl = neutralPath.Length == 0 ? root + "en" : root + "en/" + neutralPath;
    var socialImage = $"{root}Assets/og-image.svg";
}

<!DOCTYPE html>
<html lang="@language.Code()">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@Profile.NormalizedBasePath" />
    <meta name="description" content="@Profile.Tagline" />
    <meta name="author" content="@Profile.Name" />
    <meta name="theme-color" content="#0D1117" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href="@canonical" />
    <link rel="alternate" hreflang="es" href="@spanishUrl" />
    <link rel="alternate" hreflang="en" href="@englishUrl" />
    <link rel="alternate" hreflang="x-default" href="@spanishUrl" />
    <link rel="icon" type="image/svg+xml" href="Assets/favicon.svg" />
    <link rel="apple-touch-icon" href="Assets/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="@language.Code()" />
    <meta property="og:title" content="@($"{Profile.Name} — {Profile.Role}")" />
    <meta property="og:description" content="@Profile.Tagline" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@socialImage" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@($"{Profile.Name} — {Profile.Role}")" />
    <meta name="twitter:description" content="@Profile.Tagline" />
    <meta name="twitter:image" content="@socialImage" />

    <link rel="stylesheet" href="Themes/theme.css" />
    <link rel="stylesheet" href="Themes/layout.css" />
    <link rel="stylesheet" href="Themes/components.css" />
    <link rel="stylesheet" href="Themes/pages.css" />

    <HeadOutlet />
</head>

<body>
    <Routes />

    @* No framework JavaScript is loaded: the site is fully static HTML and CSS. *@
</body>

</html>
