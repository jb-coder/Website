@inject ILanguageContext LanguageContext
@inject ITranslator Localizer

@{
    var language = LanguageContext.Language;
}

<article class="pf-card pf-pattern" id="@Pattern.Id">
    <header class="pf-pattern__header">
        <span class="pf-pattern__icon" aria-hidden="true">
            <Icon Name="@Pattern.Icon" Size="20" />
        </span>
        <h3 class="pf-pattern__title">@Pattern.Name</h3>
    </header>

    <dl class="pf-pattern__details">
        <dt>@Localizer["PatternCard.Intent"]</dt>
        <dd>@Pattern.Intent.For(language)</dd>
        <dt>@Localizer["PatternCard.InProject"]</dt>
        <dd>@Pattern.Implementation.For(language)</dd>
        <dt>@Localizer["PatternCard.Benefit"]</dt>
        <dd>@Pattern.Benefit.For(language)</dd>
    </dl>

    <a class="pf-link" href="@DocumentationUrl" target="_blank" rel="noopener noreferrer">
        @Localizer["PatternCard.ReadDocs"]
        <Icon Name="arrow-up-right" Size="14" />
        <span class="pf-visually-hidden">@Localizer["Common.OpensInNewTab"]</span>
    </a>
</article>

@code {
    [Parameter, EditorRequired]
    public ArchitecturePattern Pattern { get; set; } = default!;

    [Parameter, EditorRequired]
    public string DocumentationUrl { get; set; } = string.Empty;
}
