<li class="pf-timeline__item pf-timeline__item--@TypeModifier">
    <span class="pf-timeline__marker" aria-hidden="true">
        <Icon Name="@Entry.Icon" Size="16" />
    </span>

    <article class="pf-card pf-timeline__content">
        <div class="pf-timeline__meta">
            <span class="pf-timeline__period">@Entry.Period</span>
            <span class="pf-timeline__type">@TypeLabel</span>
        </div>

        <h3 class="pf-timeline__role">@Entry.Role</h3>
        <p class="pf-timeline__company">
            @Entry.Company
            <span aria-hidden="true">·</span>
            <span class="pf-timeline__location">@Entry.Location</span>
        </p>
        <p class="pf-timeline__summary">@Entry.Summary</p>

        @if (Entry.Highlights.Count > 0)
        {
            <ul class="pf-timeline__highlights">
                @foreach (var highlight in Entry.Highlights)
                {
                    <li>
                        <Icon Name="check" Size="14" />
                        <span>@highlight</span>
                    </li>
                }
            </ul>
        }

        @if (Entry.Technologies.Count > 0)
        {
            <ul class="pf-timeline__tags" aria-label="Technologies">
                @foreach (var technology in Entry.Technologies)
                {
                    <li class="pf-tag">@technology</li>
                }
            </ul>
        }
    </article>
</li>

@code {
    [Parameter, EditorRequired]
    public Experience Entry { get; set; } = default!;

    private string TypeModifier => Entry.Type.ToString().ToLowerInvariant();

    private string TypeLabel => Entry.Type switch
    {
        ExperienceType.Work => "Experience",
        ExperienceType.Education => "Education",
        _ => "Certification",
    };
}
