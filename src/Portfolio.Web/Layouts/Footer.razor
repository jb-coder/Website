@inject LocalizedProfile Profile
@inject ILanguageContext LanguageContext
@inject ITranslator Localizer

<footer class="pf-footer">
    <div class="pf-container pf-footer__inner">
        <div class="pf-footer__about">
            <p class="pf-footer__name">@Profile.Name</p>
            <p class="pf-footer__note">@Localizer["Footer.BuiltWith"]</p>
        </div>

        <nav class="pf-footer__nav" aria-label="@Localizer["Nav.FooterAria"]">
            <ul>
                @foreach (var item in NavigationCatalog.Items)
                {
                    <li>
                        <a href="@LanguageContext.BuildHref(item.Path)">@item.Label.For(LanguageContext.Language)</a>
                    </li>
                }
            </ul>
        </nav>

        <div class="pf-footer__social">
            <a class="pf-social" href="@Profile.GitHubUrl" target="_blank" rel="noopener noreferrer" aria-label="@Localizer["Common.GithubAria"]">
                <Icon Name="github" Size="18" />
            </a>
            <a class="pf-social" href="@Profile.LinkedInUrl" target="_blank" rel="noopener noreferrer" aria-label="@Localizer["Common.LinkedInAria"]">
                <Icon Name="linkedin" Size="18" />
            </a>
            <a class="pf-social" href="@($"mailto:{Profile.Email}")" aria-label="@Localizer["Common.EmailAria", Profile.Name]">
                <Icon Name="mail" Size="18" />
            </a>
        </div>
    </div>

    <div class="pf-container pf-footer__legal">
        <p>© @DateTime.UtcNow.Year @Profile.Name. @Localizer["Common.AllRightsReserved"]</p>
        <p>@Profile.Location</p>
    </div>
</footer>
