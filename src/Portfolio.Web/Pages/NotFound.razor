@page "/not-found"
@page "/es/not-found"
@page "/en/not-found"
@layout MainLayout

@inject ITranslator Localizer
@inject LocalizedProfile Profile
@inject ILanguageContext LanguageContext

<PageTitle>@Localizer["NotFound.Eyebrow"] — @Profile.Name</PageTitle>

<section class="pf-page-hero pf-page-hero--center">
    <div class="pf-container">
        <span class="pf-eyebrow">@Localizer["NotFound.Eyebrow"]</span>
        <h1 class="pf-page-hero__title">@Localizer["NotFound.Title"]</h1>
        <p class="pf-page-hero__lead">@Localizer["NotFound.Lead"]</p>
        <div class="pf-hero__actions">
            <a class="pf-button pf-button--primary" href="@LanguageContext.BuildHref("")">
                <span>@Localizer["NotFound.Home"]</span>
                <Icon Name="arrow-right" Size="18" />
            </a>
            <a class="pf-button pf-button--ghost" href="@LanguageContext.BuildHref("projects")">
                <span>@Localizer["NotFound.Projects"]</span>
            </a>
        </div>
    </div>
</section>
