@page "/about"
@page "/en/about"

<PageTitle>@pageTitle</PageTitle>

<section class="pf-page-hero">
    <div class="pf-container">
        <span class="pf-eyebrow">@Localizer["About.Eyebrow"]</span>
        <h1 class="pf-page-hero__title">@Localizer["About.Title"]</h1>
        <p class="pf-page-hero__lead">@Localizer["About.Lead"]</p>
    </div>
</section>

<section class="pf-section" aria-labelledby="profile-title">
    <div class="pf-container pf-about">
        <aside class="pf-card pf-about__profile" aria-label="@Localizer["About.ProfileAria"]">
            <img class="pf-about__avatar" src="Assets/logo.svg" alt="" width="96" height="96" />
            <h2 class="pf-about__name" id="profile-title">@Profile.Name</h2>
            <p class="pf-about__role">@Profile.Role</p>

            <ul class="pf-about__facts">
                <li>
                    <Icon Name="map-pin" Size="16" />
                    <span>@Profile.Location</span>
                </li>
                <li>
                    <Icon Name="briefcase" Size="16" />
                    <span>@Localizer["About.Fact.Years", Profile.YearsOfExperience]</span>
                </li>
                <li>
                    <Icon Name="mail" Size="16" />
                    <a class="pf-link" href="@($"mailto:{Profile.Email}")">@Profile.Email</a>
                </li>
            </ul>

            <div class="pf-about__socials">
                <a class="pf-social" href="@Profile.GitHubUrl" target="_blank" rel="noopener noreferrer" aria-label="@Localizer["Common.GithubAria"]">
                    <Icon Name="github" Size="18" />
                </a>
                <a class="pf-social" href="@Profile.LinkedInUrl" target="_blank" rel="noopener noreferrer" aria-label="@Localizer["Common.LinkedInAria"]">
                    <Icon Name="linkedin" Size="18" />
                </a>
            </div>
        </aside>

        <div class="pf-about__bio">
            <h2 class="pf-about__heading">@Localizer["About.Bio.Heading"]</h2>

            <p>@Localizer["About.Bio.P1", Profile.YearsOfExperience]</p>
            <p>@Localizer["About.Bio.P2"]</p>
            <p>@Localizer["About.Bio.P3"]</p>

            <ul class="pf-about__principles">
                @foreach (var area in Profile.FocusAreas)
                {
                    <li class="pf-tag">@area</li>
                }
            </ul>
        </div>
    </div>
</section>

<section class="pf-section pf-section--alt" id="timeline" aria-labelledby="timeline-list-title">
    <div class="pf-container">
        <SectionHeader Section="timelineSection" />

        <ol class="pf-timeline">
            @foreach (var entry in timeline)
            {
                <TimelineItem Entry="entry" />
            }
        </ol>
    </div>
</section>
