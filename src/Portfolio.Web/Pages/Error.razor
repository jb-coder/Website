@page "/error"
@layout MainLayout

<PageTitle>Something went wrong</PageTitle>

<section class="pf-page-hero pf-page-hero--center">
    <div class="pf-container">
        <span class="pf-eyebrow">Error</span>
        <h1 class="pf-page-hero__title">Something failed while rendering this page</h1>
        <p class="pf-page-hero__lead">
            The error has been logged. Please try again or go back to the home page.
        </p>
        <div class="pf-hero__actions">
            <a class="pf-button pf-button--primary" href="">
                <span>Back to home</span>
                <Icon Name="arrow-right" Size="18" />
            </a>
        </div>
    </div>
</section>
