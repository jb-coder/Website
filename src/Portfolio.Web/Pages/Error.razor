@page "/error"
@page "/es/error"
@page "/en/error"
@layout MainLayout

@inject ITranslator Localizer
@inject ILanguageContext LanguageContext

<PageTitle>@Localizer["Error.Eyebrow"]</PageTitle>

<section class="pf-page-hero pf-page-hero--center">
    <div class="pf-container">
        <span class="pf-eyebrow">@Localizer["Error.Eyebrow"]</span>
        <h1 class="pf-page-hero__title">@Localizer["Error.Title"]</h1>
        <p class="pf-page-hero__lead">@Localizer["Error.Lead"]</p>
        <div class="pf-hero__actions">
            <a class="pf-button pf-button--primary" href="@LanguageContext.BuildHref("")">
                <span>@Localizer["Error.Home"]</span>
                <Icon Name="arrow-right" Size="18" />
            </a>
        </div>
    </div>
</section>
