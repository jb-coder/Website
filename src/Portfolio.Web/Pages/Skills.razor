@page "/skills"

<PageTitle>@pageTitle</PageTitle>

<section class="pf-page-hero">
    <div class="pf-container">
        <span class="pf-eyebrow">Skills</span>
        <h1 class="pf-page-hero__title">A stack chosen for longevity</h1>
        <p class="pf-page-hero__lead">
            Grouped by discipline. Levels reflect production experience, not tutorials completed.
        </p>
    </div>
</section>

<section class="pf-section" aria-labelledby="skills-matrix-title">
    <div class="pf-container">
        <SectionHeader Section="skillsSection" />

        <div class="pf-skills__legend" aria-label="Skill level legend">
            <span class="pf-skill__level pf-level--expert">Expert</span>
            <span>designs and leads</span>
            <span class="pf-skill__level pf-level--advanced">Advanced</span>
            <span>ships independently</span>
            <span class="pf-skill__level pf-level--intermediate">Intermediate</span>
            <span>working knowledge</span>
        </div>

        <div class="pf-grid pf-grid--skills">
            @foreach (var group in groups)
            {
                <SkillCard Group="group" />
            }
        </div>
    </div>
</section>

<section class="pf-section pf-section--alt" aria-labelledby="learning-title">
    <div class="pf-container">
        <div class="pf-note">
            <span class="pf-note__icon" aria-hidden="true">
                <Icon Name="book-open" Size="22" />
            </span>
            <div>
                <h2 class="pf-note__title" id="learning-title">Always one technology away from the next project</h2>
                <p class="pf-note__text">
                    The stack grows on demand: I learn what the problem needs, document the
                    decision and add it here when it reaches production quality.
                </p>
            </div>
        </div>
    </div>
</section>
