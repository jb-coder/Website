@page "/skills"
@page "/en/skills"

<PageTitle>@pageTitle</PageTitle>

<section class="pf-page-hero">
    <div class="pf-container">
        <span class="pf-eyebrow">@Localizer["Skills.Eyebrow"]</span>
        <h1 class="pf-page-hero__title">@Localizer["Skills.Title"]</h1>
        <p class="pf-page-hero__lead">@Localizer["Skills.Lead"]</p>
    </div>
</section>

<section class="pf-section" aria-labelledby="skills-matrix-title">
    <div class="pf-container">
        <SectionHeader Section="skillsSection" />

        <div class="pf-skills__legend" aria-label="@Localizer["Skills.Eyebrow"]">
            <span class="pf-skill__level pf-level--expert">@Localizer["SkillLevel.Expert"]</span>
            <span>@Localizer["Skills.Legend.ExpertHint"]</span>
            <span class="pf-skill__level pf-level--advanced">@Localizer["SkillLevel.Advanced"]</span>
            <span>@Localizer["Skills.Legend.AdvancedHint"]</span>
            <span class="pf-skill__level pf-level--intermediate">@Localizer["SkillLevel.Intermediate"]</span>
            <span>@Localizer["Skills.Legend.IntermediateHint"]</span>
        </div>

        <div class="pf-grid pf-grid--skills">
            @foreach (var group in groups)
            {
                <SkillCard Group="group" />
            }
        </div>
    </div>
</section>

<section class="pf-section pf-section--alt" aria-labelledby="learning-title">
    <div class="pf-container">
        <div class="pf-note">
            <span class="pf-note__icon" aria-hidden="true">
                <Icon Name="book-open" Size="22" />
            </span>
            <div>
                <h2 class="pf-note__title" id="learning-title">@Localizer["Skills.Note.Title"]</h2>
                <p class="pf-note__text">@Localizer["Skills.Note.Text"]</p>
            </div>
        </div>
    </div>
</section>
