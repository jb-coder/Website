@page "/projects"
@page "/en/projects"

<PageTitle>@pageTitle</PageTitle>

<section class="pf-page-hero">
    <div class="pf-container">
        <span class="pf-eyebrow">@Localizer["Projects.Eyebrow"]</span>
        <h1 class="pf-page-hero__title">@Localizer["Projects.Title"]</h1>
        <p class="pf-page-hero__lead">@Localizer["Projects.Lead"]</p>
    </div>
</section>

<section class="pf-section" aria-labelledby="projects-catalogue-title">
    <div class="pf-container">
        <SectionHeader Section="projectsSection" />

        <nav class="pf-filters" aria-label="@Localizer["Projects.Eyebrow"]">
            <ul class="pf-filters__list">
                @foreach (var filter in filters)
                {
                    <li>
                        <a class="pf-filters__item @(IsActive(filter.Value) ? "pf-filters__item--active" : string.Empty)"
                           href="@BuildFilterHref(filter.Value)"
                           aria-current="@(IsActive(filter.Value) ? "page" : null)">
                            <Icon Name="@filter.Icon" Size="15" />
                            <span>@filter.Label</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>

        <p class="pf-projects__count" role="status">
            @Localizer["Projects.Showing"] <strong>@projects.Count</strong>
            @(projects.Count == 1 ? Localizer["Projects.CountSingular"] : Localizer["Projects.CountPlural"])
            @if (!string.IsNullOrEmpty(Category))
            {
                <span>@Localizer["Projects.InCategory", CategoryLabel]</span>
            }
        </p>

        @if (projects.Count == 0)
        {
            <div class="pf-empty">
                <p>@Localizer["Projects.Empty"]</p>
                <a class="pf-link" href="@LanguageContext.BuildHref("projects")">@Localizer["Projects.ShowAll"]</a>
            </div>
        }
        else
        {
            <div class="pf-grid pf-grid--projects">
                @foreach (var project in projects)
                {
                    <ProjectCard Project="project" />
                }
            </div>
        }
    </div>
</section>
