@page "/es/architecture"
@page "/en/architecture"

<PageTitle>@pageTitle</PageTitle>

<HeadContent>
    <script type="module">
        import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@@11/dist/mermaid.esm.min.mjs';
        mermaid.initialize({ startOnLoad: true, theme: 'dark', securityLevel: 'strict' });
    </script>
</HeadContent>

<section class="pf-page-hero">
    <div class="pf-container">
        <span class="pf-eyebrow">@Localizer["Architecture.Eyebrow"]</span>
        <h1 class="pf-page-hero__title">@Localizer["Architecture.Title"]</h1>
        <p class="pf-page-hero__lead">@Localizer["Architecture.Lead"]</p>
    </div>
</section>

<section class="pf-section" aria-labelledby="request-flow-title">
    <div class="pf-container">
        <SectionHeader Section="layersSection" />

        <ol class="pf-layers" aria-label="@Localizer["Architecture.Layers.Eyebrow"]">
            @foreach (var layer in layers)
            {
                <li class="pf-layers__item">
                    <span class="pf-layers__icon" aria-hidden="true">
                        <Icon Name="@layer.Icon" Size="20" />
                    </span>
                    <div class="pf-layers__body">
                        <h3 class="pf-layers__title">@layer.Title</h3>
                        <p class="pf-layers__text">@layer.Text</p>
                        <ul class="pf-layers__examples">
                            @foreach (var example in layer.Examples)
                            {
                                <li class="pf-tag">@example</li>
                            }
                        </ul>
                    </div>
                </li>
            }
        </ol>
    </div>
</section>

<section class="pf-section pf-section--alt" aria-labelledby="dependency-diagram-title">
    <div class="pf-container">
        <SectionHeader Section="diagramSection" />

        <div class="pf-diagram pf-card">
            <pre class="mermaid">
flowchart LR
    A[Pages and Components] --> B[Mediator]
    B --> C[Query Handlers]
    C --> D[Repositories]
    C --> E[Strategies]
    C --> F[Factories and Builders]
    D --> G[Static Data]
    E --> G
    F --> G
            </pre>
        </div>

        <p class="pf-diagram__note">@Localizer["Architecture.Diagram.Note"]</p>
    </div>
</section>

<section class="pf-section" aria-labelledby="patterns-title">
    <div class="pf-container">
        <SectionHeader Section="patternsSection" />

        <div class="pf-grid pf-grid--patterns">
            @foreach (var pattern in patterns)
            {
                <PatternCard Pattern="pattern" DocumentationUrl="@BuildDocumentationUrl(pattern)" />
            }
        </div>
    </div>
</section>

<section class="pf-section pf-section--alt" aria-labelledby="solid-title">
    <div class="pf-container">
        <SectionHeader Section="solidSection" />

        <div class="pf-grid pf-grid--three">
            @foreach (var principle in solidPrinciples)
            {
                <article class="pf-card pf-principle">
                    <span class="pf-principle__icon" aria-hidden="true">
                        <Icon Name="check" Size="20" />
                    </span>
                    <h3 class="pf-principle__title">@principle.Letter — @principle.Name</h3>
                    <p class="pf-principle__text">@principle.Text</p>
                </article>
            }
        </div>
    </div>
</section>

<section class="pf-section" aria-labelledby="quality-title">
    <div class="pf-container">
        <SectionHeader Section="qualitySection" />

        <ul class="pf-quality" aria-label="@Localizer["Architecture.Quality.Eyebrow"]">
            @foreach (var gate in qualityGates)
            {
                <li class="pf-quality__item">
                    <Icon Name="shield" Size="18" />
                    <span>@gate</span>
                </li>
            }
        </ul>
    </div>
</section>
