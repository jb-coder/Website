@page "/contact"
@page "/en/contact"

<PageTitle>@pageTitle</PageTitle>

<section class="pf-page-hero">
    <div class="pf-container">
        <span class="pf-eyebrow">@Localizer["Contact.Eyebrow"]</span>
        <h1 class="pf-page-hero__title">@Localizer["Contact.Title"]</h1>
        <p class="pf-page-hero__lead">@Profile.Availability</p>
    </div>
</section>

<section class="pf-section" aria-labelledby="contact-channels-title">
    <div class="pf-container">
        <SectionHeader Section="contactSection" />

        <div class="pf-grid pf-grid--contact">
            <ContactCard Label="Email"
                         Value="@Profile.Email"
                         Href="@($"mailto:{Profile.Email}?subject=Opportunity%20for%20{Profile.Name}")"
                         Icon="mail"
                         Accent="#58A6FF" />
            <ContactCard Label="@Localizer["Contact.LinkedIn.Label"]"
                         Value="@Localizer["Contact.LinkedIn.Value"]"
                         Href="@Profile.LinkedInUrl"
                         Icon="linkedin"
                         Accent="#79C0FF" />
            <ContactCard Label="@Localizer["Contact.GitHub.Label"]"
                         Value="@Localizer["Contact.GitHub.Value"]"
                         Href="@Profile.GitHubUrl"
                         Icon="github"
                         Accent="#A5D6FF" />
            <ContactCard Label="@Localizer["Contact.Location.Label"]"
                         Value="@Profile.Location"
                         Href="@BuildMapUrl()"
                         Icon="map-pin"
                         Accent="#6CB6FF" />
        </div>

        <div class="pf-card pf-contact-note">
            <span class="pf-contact-note__icon" aria-hidden="true">
                <Icon Name="zap" Size="22" />
            </span>
            <div>
                <h2 class="pf-contact-note__title" id="contact-title">@Localizer["Contact.Note.Title"]</h2>
                <p class="pf-contact-note__text">@Localizer["Contact.Note.Text"]</p>
            </div>
        </div>
    </div>
</section>
